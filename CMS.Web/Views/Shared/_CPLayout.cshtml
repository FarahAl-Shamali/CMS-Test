<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - لوحة التحكم</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/assets/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/dist/css/adminlte.min.css" />

    <style>
        :root {
            --cp-bg: #f0f2fa;
            --cp-primary: #3f8ef5;
            --cp-primary-soft: #e8f0fd;
            --cp-text: #6c757d;
            --cp-border: #eceef5;
            --cp-sidebar-w: 250px;
            --cp-header-h: 57px;
            --cp-user-w: 280px;
        }
        body.cp-collapsed { --cp-sidebar-w: 72px; }

        html, body, h1, h2, h3, h4, h5, h6, p, a, span, button, .btn {
            font-family: 'Cairo', sans-serif;
        }
        body {
            margin: 0;
            background: var(--cp-bg);
            color: var(--cp-text);
            overflow-x: hidden;
        }

        /* ===================== شاشة التحميل ===================== */
        .cp-preloader {
            position: fixed; inset: 0; z-index: 99999;
            background: #fff;
            display: flex; align-items: center; justify-content: center;
            transition: opacity .4s ease, visibility .4s ease;
        }
        .cp-preloader img { max-height: 90px; max-width: 220px; animation: cpPulse 1.2s ease-in-out infinite; }
        .cp-preloader.cp-hide { opacity: 0; visibility: hidden; }
        @@keyframes cpPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50%      { transform: scale(1.08); opacity: .7; }
        }

        /* ===================== السايدبار (يمين) ===================== */
        .cp-sidebar {
            position: fixed; top: 0; bottom: 0; right: 0;
            width: var(--cp-sidebar-w);
            background: #fff;
            border-left: 1px solid var(--cp-border);
            box-shadow: 0 0 15px rgba(0,0,0,.05);
            z-index: 1040;
            overflow-x: hidden; overflow-y: auto;
            transition: width .25s ease, transform .25s ease;
        }

        /* رأس السايدبار: اللوجو يمين، زر الطي شمال */
            .cp-brand {
                direction: ltr;
                position: relative;
                height: var(--cp-header-h);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 1rem;
                border-bottom: 1px solid var(--cp-border);
            }

            .cp-collapse-btn {
                position: absolute;
                left: .5rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: 0;
                cursor: pointer;
                color: #aab0c0;
                font-size: 1.1rem;
                padding: .25rem .5rem;
            }
            .cp-logo img {
                max-height: 34px;
                max-width: 120px;
                display: block;
            }

        .cp-collapse-btn:hover { color: var(--cp-primary); }
        .cp-collapse-btn i { transition: transform .25s; }

        /* القائمة */
        .cp-nav { list-style: none; margin: 0; padding: 1rem .75rem; direction: rtl; }
        .cp-nav li { margin-bottom: 4px; }
        .cp-nav a {
            display: flex; align-items: center; gap: .7rem;
            padding: .5rem .6rem;
            border-radius: 8px;
            color: var(--cp-text);
            text-decoration: none;
            white-space: nowrap;
        }
        .cp-nav a .cp-ico {
            width: 2rem; height: 2rem; flex-shrink: 0;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 8px;
            background: var(--cp-primary-soft); color: var(--cp-primary);
            font-size: .95rem;
        }
        .cp-nav a:hover, .cp-nav a.active { background: #f1f4fb; color: var(--cp-primary); }

        /* ===================== الشريط العلوي ===================== */
        .cp-header {
            position: fixed; top: 0; left: 0; right: var(--cp-sidebar-w);
            height: var(--cp-header-h);
            background: #fff;
            box-shadow: 0 1px 8px rgba(0,0,0,.04);
            z-index: 1030;
            direction: ltr;                     /* نثبّت الأماكن: الشمال = ترحيب، اليمين = زر المستخدم */
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 1.25rem;
            transition: right .25s ease;
        }
        .cp-header-right { display: flex; align-items: center; gap: .5rem; }
        .cp-greeting { direction: rtl; color: #8a90a2; font-size: .95rem; }
        .cp-greeting b { color: #444b5e; }
        a.cp-greeting { text-decoration: none; cursor: pointer; }
        a.cp-greeting:hover, a.cp-greeting:hover b { color: var(--cp-primary); text-decoration: none; }
        .cp-icon-btn {
            width: 36px; height: 36px; border: 0; border-radius: 8px; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--cp-primary-soft); color: var(--cp-primary);
        }
        .cp-burger { display: none; background: none; color: #8a90a2; }

        /* ===================== المحتوى ===================== */
        .cp-main {
            margin-right: var(--cp-sidebar-w);
            padding-top: var(--cp-header-h);
            min-height: 100vh;
            display: flex; flex-direction: column;
            transition: margin .25s ease;
        }
        .cp-content { flex: 1; padding: 1.5rem 1rem; }
        .cp-footer {
            direction: ltr; text-align: left;
            background: #fff; border-top: 1px solid var(--cp-border);
            padding: .9rem 1.25rem; color: #9aa0b3; font-size: .85rem;
        }

        /* ===================== لوحة معلومات المستخدم (شمال) ===================== */
        .cp-backdrop {
            position: fixed; inset: 0; background: rgba(60,64,90,.35);
            z-index: 1050; opacity: 0; visibility: hidden; transition: opacity .3s;
        }
        .cp-user-panel {
            position: fixed; top: 0; bottom: 0; left: calc(var(--cp-user-w) * -1);
            width: var(--cp-user-w);
            background: #fff; z-index: 1060;
            padding: 1.25rem 1rem; direction: rtl;
            box-shadow: 4px 0 20px rgba(0,0,0,.12);
            transition: left .3s ease;
        }
        body.cp-user-open .cp-user-panel { left: 0; }
        body.cp-user-open .cp-backdrop { opacity: 1; visibility: visible; }

        .cp-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
        .cp-panel-head h5 { margin: 0; color: #666d80; font-weight: 400; }
        .cp-close { width: 28px; height: 28px; border: 0; border-radius: 6px; background: #f1f3f9; color: #8a90a2; cursor: pointer; }
        .cp-user-card { display: flex; align-items: flex-start; gap: .75rem; }
        .cp-avatar {
            position: relative; width: 64px; height: 64px; flex-shrink: 0;
            border-radius: 8px; background: #f1f4fb; color: #b6bdd0; font-size: 1.8rem;
            display: flex; align-items: center; justify-content: center;
        }
        .cp-online {
            position: absolute; top: -4px; right: -4px; width: 11px; height: 11px;
            background: #20c997; border-radius: 50%; border: 2px solid #fff;
        }
        .cp-user-name { color: #666d80; margin: 0; line-height: 1.3; }
        .cp-user-role { color: #aab0c0; font-size: .8rem; margin-bottom: .6rem; }
        .cp-logout {
            display: inline-block; background: #dcebfd; color: var(--cp-primary);
            border-radius: 4px; font-size: .8rem; padding: .25rem .9rem; text-decoration: none;
        }
        .cp-logout:hover { background: #cbe0fb; color: var(--cp-primary); text-decoration: none; }

        /* ===================== سايدبار مطوي (شاشات كبيرة) ===================== */
        @@media (min-width: 992px) {
            body.cp-collapsed .cp-label,
            body.cp-collapsed .cp-logo { display: none; }
            body.cp-collapsed .cp-brand { justify-content: center; }
            body.cp-collapsed .cp-collapse-btn i { transform: rotate(180deg); }
            body.cp-collapsed .cp-nav a { justify-content: center; padding-left: 0; padding-right: 0; }
        }

        /* ===================== موبايل ===================== */
        @@media (max-width: 991.98px) {
            .cp-sidebar { width: 250px; transform: translateX(100%); }
            body.cp-mobile-open .cp-sidebar { transform: none; }
            .cp-header { right: 0; }
            .cp-main { margin-right: 0; }
            .cp-burger { display: inline-flex; }
            .cp-collapse-btn { display: none; }
            .cp-brand { justify-content: flex-end; }
            .cp-mobile-backdrop {
                position: fixed; inset: 0; background: rgba(0,0,0,.3); z-index: 1035;
                display: none;
            }
            body.cp-mobile-open .cp-mobile-backdrop { display: block; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <!-- ===================== شاشة التحميل ===================== -->
    <div class="cp-preloader" id="cpPreloader">
        <img src="~/ThemeImages/CMSlogo.png" alt="Logo" />
    </div>

    <!-- ===================== السايدبار ===================== -->
    <aside class="cp-sidebar" id="cpSidebar">
        <div class="cp-brand">
            <button type="button" class="cp-collapse-btn" id="cpCollapse" title="طي القائمة">
                <i class="fas fa-angle-double-left"></i>
            </button>
            <a href="~/" class="cp-logo">
                <img src="~/ThemeImages/CMSlogo.png" alt="Logo" />
            </a>
        </div>

        <ul class="cp-nav">
            <li>
                <a href="~/" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <span class="cp-ico"><i class="fas fa-home"></i></span>
                    <span class="cp-label">الرئيسية</span>
                </a>
            </li>
             <li>
                <a href="~/Users">
                    <span class="cp-ico"><i class="fas fa-users"></i></span>
                    <span class="cp-label">إدارة المستخدمين</span>
                </a>
            </li>
             <li>
                <a href="~/Users">
                    <span class="cp-ico"><i class="fas fa-th-large"></i></span>
                    <span class="cp-label">إدارة التصنيفات</span>
                </a>
            </li>
             <li>
                <a href="~/Users">
                    <span class="cp-ico"><i class="fas fa-newspaper"></i></span>
                    <span class="cp-label">إدارة الأخبار</span>
                </a>
            </li>
             <li>
                <a href="~/Users">
                    <span class="cp-ico"><i class="fas fa-microphone"></i></span>
                    <span class="cp-label">إدارة التسجيلات الصوتية</span>
                </a>
            </li>
             <li>
                <a href="~/Users">
                    <span class="cp-ico"><i class="fas fa-bullhorn"></i></span>
                    <span class="cp-label">الإعلانات</span>
                </a>
            </li>

            @* أمثلة لعناصر إضافية - فك التعليق وعدّل حسب مشروعك
            <li>
                <a href="~/Users">
                    <span class="cp-ico"><i class="fas fa-users"></i></span>
                    <span class="cp-label">المستخدمون</span>
                </a>
            </li>
            *@
        </ul>
    </aside>
    <div class="cp-mobile-backdrop" id="cpMobileBackdrop"></div>

    <!-- ===================== الشريط العلوي ===================== -->
    <header class="cp-header">
        <!-- شمال: الترحيب -->
        <a href="#" class="cp-greeting" id="cpGreeting" title="معلومات المستخدم">
            أهلاً بك يا <b>@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "أحمد")</b>
        </a>

        <!-- يمين: زر المستخدم -->
        <div class="cp-header-right">
            <button type="button" class="cp-icon-btn cp-burger" id="cpBurger"><i class="fas fa-bars"></i></button>
        </div>
    </header>

    <!-- ===================== المحتوى ===================== -->
    <div class="cp-main">
        <main class="cp-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>
        <footer class="cp-footer">
            <strong>CMS &copy; @DateTime.Now.Year</strong>
        </footer>
    </div>

    <!-- ===================== لوحة معلومات المستخدم ===================== -->
    <div class="cp-backdrop" id="cpBackdrop"></div>
    <aside class="cp-user-panel">
        <div class="cp-panel-head">
            <h5>معلومات المستخدم</h5>
            <button type="button" class="cp-close" id="cpUserClose"><i class="fas fa-times"></i></button>
        </div>
        <div class="cp-user-card">
            <div class="cp-avatar">
                <i class="fas fa-user"></i>
                <span class="cp-online"></span>
            </div>
            <div>
                <h6 class="cp-user-name">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Ahmed Shalayel")</h6>
                <div class="cp-user-role">Admin</div>
                <a href="~/Account/Logout" class="cp-logout">تسجيل الخروج</a>
            </div>
        </div>
    </aside>

    <script src="~/assets/plugins/jquery/jquery.min.js"></script>
    <script src="~/assets/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/dist/js/adminlte.min.js"></script>
    <script>
        (function () {
            var body = document.body;
            var $ = function (id) { return document.getElementById(id); };

            // طي/فتح السايدبار (مع حفظ الحالة)
            try { if (localStorage.getItem('cpCollapsed') === '1') body.classList.add('cp-collapsed'); } catch (e) {}
            $('cpCollapse').addEventListener('click', function () {
                var c = body.classList.toggle('cp-collapsed');
                try { localStorage.setItem('cpCollapsed', c ? '1' : '0'); } catch (e) {}
            });

            // سايدبار الموبايل
            $('cpBurger').addEventListener('click', function () { body.classList.toggle('cp-mobile-open'); });
            $('cpMobileBackdrop').addEventListener('click', function () { body.classList.remove('cp-mobile-open'); });

            // لوحة المستخدم
            function openUser()  { body.classList.add('cp-user-open'); }
            function closeUser() { body.classList.remove('cp-user-open'); }

            // إخفاء شاشة التحميل بعد ما تخلص الصفحة
            function hideLoader() {
                var l = $('cpPreloader');
                if (!l) return;
                l.classList.add('cp-hide');
                setTimeout(function () { l.style.display = 'none'; }, 400);
            }
            if (document.readyState === 'complete') hideLoader();
            else window.addEventListener('load', hideLoader);
            $('cpGreeting').addEventListener('click', function (e) { e.preventDefault(); openUser(); });
            $('cpUserClose').addEventListener('click', closeUser);
            $('cpBackdrop').addEventListener('click', closeUser);
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeUser(); });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>